      }
    },
    {
      "when": {
        "hi_x": "true"
      },
      "apply": {
        "model": "recompile:block/compost_wire_east"
      }
    },
    {
      "when": {
        "hi_z": "false"
      },
      "apply": {
        "model": "recompile:block/compost_wire_north"
      }
    },
    {
      "when": {
        "hi_z": "true"
      },
      "apply": {
        "model": "recompile:block/compost_wire_south"
      }
    },
    {
      "when": {
