{
  "multipart": [
    { "when": { "x": "false", "z": "false" }, "apply": { "model": "recompile:block/steel_beam_pole" } },
    { "when": { "x": "true" },  "apply": { "model": "recompile:block/steel_beam_x" } },
    { "when": { "z": "true" },  "apply": { "model": "recompile:block/steel_beam_z" } },

    { "when": { "top": "true",    "x": "true",  "z": "false" }, "apply": { "model": "recompile:block/steel_beam_top" } },
    { "when": { "bottom": "true", "x": "true",  "z": "false" }, "apply": { "model": "recompile:block/steel_beam_bottom" } },
    { "when": { "top": "true",    "x": "false", "z": "true" },  "apply": { "model": "recompile:block/steel_beam_top" } },
    { "when": { "bottom": "true", "x": "false", "z": "true" },  "apply": { "model": "recompile:block/steel_beam_bottom" } },

    { "when": { "x": "true", "z": "true" }, "apply": { "model": "recompile:block/steel_beam_cross" } }
  ]
}
